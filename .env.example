# ============================================================
# 心灯（Light）环境变量模板 — 复制为 .env 后填写真实值
# 硬性规则 9：真实 .env 绝不提交仓库（已被 .gitignore 排除）
# ============================================================

# ---- 数据库（MySQL 5.7 开发基线 / MySQL 8 部署目标，utf8mb4）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=light
DB_USER=light
DB_PASSWORD=CHANGE_ME
# 或直接使用完整连接串（优先级更高，二选一）：
# ConnectionStrings__Default=Server=127.0.0.1;Port=3306;Database=light;User ID=light;Password=CHANGE_ME;SslMode=None

# ---- Redis（阶段 6 部署时启用；当前验证码为内存 mock）----
REDIS_CONNECTION=127.0.0.1:6379

# ---- 应用层加密（AES-GCM，32 字节随机数的 base64）----
# 生成：python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
AES_DATA_KEY=CHANGE_ME_BASE64_32BYTES

# ---- JWT ----
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS
Jwt__Issuer=light-api
Jwt__Audience=light-clients
Jwt__AccessTokenMinutes=60
Jwt__RefreshTokenDays=14

# ---- 危机干预（硬性规则 2：一律可配置，上线前人工核实，不得凭记忆填号码）----
# JSON 数组：[{"name":"...","number":"...","note":"..."}]
CRISIS_HOTLINES=[{"name":"心理援助热线（占位）","number":"0-000-000000","note":"上线前人工核实"}]
# AI 危机固定安全话术（阶段 5 启用）
CRISIS_SAFE_REPLY=CHANGE_ME_BEFORE_LAUNCH

# ---- 社区（Discourse，阶段 3/6）----
DISCOURSE_SSO_ENABLED=false
DISCOURSE_SSO_SECRET=CHANGE_ME_RANDOM_32PLUS
COMMUNITY_CALLBACK_SECRET=CHANGE_ME_RANDOM_32PLUS

# ---- AI 陪伴（阶段 5）----
AI_API_BASE=
AI_API_KEY=
AI_MODEL=

# ---- 迁移 ----
Migrations__RunOnStartup=true

# ---- CORS（前端来源，逗号分隔由配置文件数组覆盖时用 Cors__AllowedOrigins__0 等）----
# Cors__AllowedOrigins__0=https://light.example.com
